# ── Server ──────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# The Vite dev server. Comma-separate to allow several origins.
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# ── Security ────────────────────────────────────────────
# Signs session tokens. Use a long random string (e.g. `openssl rand -hex 32`).
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ── Storage ─────────────────────────────────────────────
# JSON file database, created on first run.
DATA_FILE=./data/db.json

# ── AI assistant ────────────────────────────────────────
# Leave GROQ_API_KEY empty → the built-in MOCK assistant answers (free, offline,
# rule-based). Add a Groq key to use Groq's Chat Completions API.
GROQ_API_KEY=
AI_MODEL=openai/gpt-oss-20b
AI_TIMEOUT_MS=60000

# Groq (free tier, very fast; keys: https://console.groq.com/keys)
#   GROQ_API_KEY=<your key>
#   AI_MODEL=openai/gpt-oss-20b
